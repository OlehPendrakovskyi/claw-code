{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "chat.send result",
  "x-source": "src/gateway/server-methods/chat-send-handler.ts ackPayload and dedupe replies (openclaw 2026.9.6)",
  "type": "object",
  "required": ["runId", "status"],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["started", "in_flight", "ok", "error", "timeout", "accepted"] },
    "messageSeq": { "type": "integer", "minimum": 1 },
    "interruptedActiveRun": { "type": "boolean" },
    "summary": { "type": "string" }
  },
  "not": { "required": ["sessionKey"] }
}
