        },
        {
            "name": "R54: hook with a typed parameter",
            "file": "src/__test__/d.test.ts",
            "line": "beforeEach(async (ctx: TestContext) => ctx.skip());",
            "expect": "R54"
        },
        {
            "name": "R54 clean: block-bodied hook",
            "file": "src/__test__/d.test.ts",
            "line": "beforeEach(() => {",
            "expect": null
        },
        {
            "name": "R54 clean: block-bodied hook with a context parameter",
            "file": "src/__test__/d.test.ts",
            "line": "afterEach((ctx) => {",
            "expect": null
        }
    ]
}
